# OpsDesk Application Configuration
APP_NAME=opsdesk
APP_ENV=development
APP_PORT=8000
DEBUG=true

# Database Configuration
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=opsdesk
DATABASE_USER=opsdesk
DATABASE_PASSWORD=opsdesk_secret_password
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:8080

# Background Job Configuration
BACKGROUND_JOB_INTERVAL_SECONDS=60
